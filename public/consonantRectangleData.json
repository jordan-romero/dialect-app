  "mannerDefinitions": {
    "Plosive": "A consonant produced by articulators stopping the airflow from the lungs, followed by a sudden release of the pressurized air.",
    "Nasal": "Sounds produced when the soft palate lowers to divert vibrated airflow into the nasal cavity.",
    "Tap/Flap": "A quick tongue tap off of an articulation surface.",
    "Fricative": "Produced when the airflow is constricted by the articulators at any point in the vocal tract to create turbulence.",
    "Approximant": "When the articulators approximate an articulation, but release before contact.",
    "Lateral approximant": "Where airflow is released sideways across the tongue."
  },
  "placeDefinitions": {
    "Bilabial": "Sounds articulated by both lips.",
    "Labiodental": "Consonants which use one lip and one set of teeth.",
    "Dental": "Sounds where the tongue articulates off the teeth.",
    "Alveolar": "The alveolar ridge right behind the gumline of the top front teeth.",
    "Postalveolar": "Consonants produced behind the alveolar ridge.",
    "Palatal": "Sounds expressed off the hard palate.",
    "Velar": "The soft palate near the back of the mouth.",
    "Glottal": "Sounds which emanate from the space between the vocal folds (the glottis)."
  }
}
