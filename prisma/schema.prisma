// Prisma schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DEV_POSTGRES_PRISMA_URL")
  directUrl = env("DEV_POSTGRES_URL_NON_POOLING")
}

// User Model
model User {
  id                     Int              @id @default(autoincrement())
  auth0Id                String           @unique
  email                  String           @unique
  firstName              String?
  lastName               String?
  avatar                 String?
  bio                    String?
  interests              String[]         @default([])
  badges                 String[]         @default([])
  hasAccessToPaidCourses Boolean          @default(false)
  hasSeenWelcome         Boolean          @default(false)
  role                   Role             @default(STUDENT)
  enrollments            Enrollment[]
  lessonProgress         LessonProgress[]
  userAnswers            UserAnswer[]
  teaching               Cohort[]         @relation("CohortTeacher")
  memberships            CohortMember[]
  purchases              Purchase[]
}

// Role-based access. Permissions per role live in lib/rbac.ts.
enum Role {
  STUDENT
  TEACHER
  ADMIN
}

// Course Model
model Course {
  id            Int          @id @default(autoincrement())
  title         String
  description   String
  isCompleted   Boolean      @default(false)
  isGatedCourse Boolean      @default(true)
  lessons       Lesson[]
  resources     Resource[]
  enrollments   Enrollment[]
}

model Lesson {
  id                  Int              @id @default(autoincrement())
  title               String
  description         String
  videoUrl            String?
  videoTitle          String?
  quiz                Quiz[]
  courseId            Int
  course              Course           @relation(fields: [courseId], references: [id])
  resources           Resource[]
  passScore           Int?
  isCompleted         Boolean          @default(false)
  isGatedLesson       Boolean          @default(true)
  lessonProgress      LessonProgress[]
  steps               Json?
  displayOrder        Int?
  // When false, the IPA keyboard PIP won't pop open by itself as soon as an
  // IPA field is focused in this lesson. The user can still open it manually.
  autoOpenIpaKeyboard Boolean          @default(true)
}

// LessonProgress Model
model LessonProgress {
  id                   Int      @id @default(autoincrement())
  lessonId             Int
  progress             Float
  updatedAt            DateTime @updatedAt
  lesson               Lesson   @relation(fields: [lessonId], references: [id])
  user                 User     @relation(fields: [userId], references: [id])
  userId               Int
  hasVideoBeenWatched  Boolean?
  hasQuizBeenCompleted Boolean?

  @@unique([userId, lessonId])
}

// Quiz model
model Quiz {
  id               Int          @id @default(autoincrement())
  title            String?
  questions        Question[]
  lessonId         Int
  lesson           Lesson       @relation(fields: [lessonId], references: [id])
  score            Int?
  passScore        Int?
  hasBeenAttempted Boolean      @default(false)
  quizType         String?
  order            Int          @default(0)
  isCompleted      Boolean      @default(false)
  userAnswers      UserAnswer[]
  // Overrides the exercise component's built-in instruction text. The generic
  // components infer wording from the quiz shape, which is wrong for one-off
  // exercises (e.g. 13b.B asks the learner to match audio to a transcription).
  instructions     String?
}

// Question Model
model Question {
  id            Int            @id @default(autoincrement())
  text          String
  questionType  String
  quizId        Int
  quiz          Quiz           @relation(fields: [quizId], references: [id])
  answerOptions AnswerOption[]
  extraOptions  ExtraOption[]
  categories    String[]
  audioUrl      String?
  userAnswers   UserAnswer[]
}

// AnswerOption Model
model AnswerOption {
  id            Int      @id @default(autoincrement())
  optionText    String
  isCorrect     Boolean
  rhymeCategory String?
  rhymingWordId Int?
  audioUrl      String?
  feedback      String?
  questionId    Int
  question      Question @relation(fields: [questionId], references: [id])
}

// ExtraOption Model
model ExtraOption {
  id         Int      @id @default(autoincrement())
  optionText String
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
}

// Resource Model
model Resource {
  id       Int     @id @default(autoincrement())
  name     String
  type     String
  url      String
  courseId Int?
  lessonId Int?
  course   Course? @relation(fields: [courseId], references: [id])
  lesson   Lesson? @relation(fields: [lessonId], references: [id])
  order    Int     @default(0)

  @@unique([courseId, lessonId])
}

// UserAnswer Model
model UserAnswer {
  id         Int      @id @default(autoincrement())
  quizId     Int
  quiz       Quiz     @relation(fields: [quizId], references: [id])
  questionId Int
  question   Question @relation(fields: [questionId], references: [id])
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  textAnswer String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, questionId, quizId])
}

// Enrollment Model
model Enrollment {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
}

// ---- Cohorts (teacher-led classes) ----

enum CohortPayment {
  SELF_PAY // each student buys the course themselves
  SEATS // the teacher/institution bought a seat package
}

model Cohort {
  id          Int            @id @default(autoincrement())
  name        String
  institution String?
  teacherId   Int
  teacher     User           @relation("CohortTeacher", fields: [teacherId], references: [id])
  paymentMode CohortPayment
  // Seats bought, kept in step with PAID seat purchases by the webhook.
  seatCount   Int            @default(0)
  joinCode    String         @unique
  joinEnabled Boolean        @default(true)
  startsAt    DateTime?
  // Seat access ends here (required for SEATS cohorts, enforced in the API).
  endsAt      DateTime?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  members     CohortMember[]
  invites     CohortInvite[]
  purchases   Purchase[]

  @@index([teacherId])
}

model CohortMember {
  id        Int       @id @default(autoincrement())
  cohortId  Int
  userId    Int
  joinedAt  DateTime  @default(now())
  // True when this member's course access comes from the cohort's seats.
  usesSeat  Boolean   @default(false)
  // Soft remove (by the teacher, or the student leaving); frees the seat.
  removedAt DateTime?
  cohort    Cohort    @relation(fields: [cohortId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@unique([cohortId, userId])
  @@index([userId])
}

model CohortInvite {
  id         Int       @id @default(autoincrement())
  cohortId   Int
  email      String // lower-cased
  token      String    @unique
  createdAt  DateTime  @default(now())
  acceptedAt DateTime?
  acceptedBy Int?
  revokedAt  DateTime?
  cohort     Cohort    @relation(fields: [cohortId], references: [id])

  @@unique([cohortId, email])
}

// ---- Purchases (one row per Stripe Checkout Session) ----

enum PurchaseKind {
  COURSE
  SEATS
}

enum PurchaseStatus {
  PAID
  REFUNDED
  DISPUTED
}

model Purchase {
  id                    Int            @id @default(autoincrement())
  userId                Int?
  user                  User?          @relation(fields: [userId], references: [id])
  cohortId              Int?
  cohort                Cohort?        @relation(fields: [cohortId], references: [id])
  kind                  PurchaseKind
  quantity              Int            @default(1)
  amountTotal           Int // cents
  // Refunded so far (cents). Seat purchases lose seats in proportion.
  amountRefunded        Int            @default(0)
  currency              String
  stripeSessionId       String         @unique
  stripePaymentIntentId String?        @unique
  status                PurchaseStatus
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
}
