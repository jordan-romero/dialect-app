# Copy to `.env` and fill in real values. `.env` is gitignored — never commit secrets.
# Production/staging values live in the Vercel project's Environment Variables.

# ---- Database (Supabase Postgres, via Prisma) ----
DEV_POSTGRES_PRISMA_URL=postgresql://user:password@host:6543/postgres?pgbouncer=true
DEV_POSTGRES_URL_NON_POOLING=postgresql://user:password@host:5432/postgres

# ---- Auth0 (read by @auth0/nextjs-auth0) ----
# Generate a secret with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# ---- AWS S3 (private bucket; URLs are presigned in lib/s3.ts) ----
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=

# ---- Stripe ----
# Use TEST keys locally; LIVE keys belong only in Vercel production.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ---- Mailchimp (newsletter signup) ----
MAILCHIMP_API_KEY=
MAILCHIMP_API_SERVER=usX
MAILCHIMP_AUDIENCE_ID=

# ---- ConfigCat (feature flags, client-side) ----
NEXT_PUBLIC_CONFIGCAT_SDK_KEY=

# ---- App config ----
# Comma-separated admin emails or whole domains (e.g. @example.com). Grants the
# test-card hint in the unlock modal; does NOT bypass the paywall.
ADMIN_EMAILS=
